{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games",
  "main": "src/index.js",
  "compatibility_date": "2026-07-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "ACCOUNTS", "id": "e6faf92ca1ae442baa47195b70e4266d" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ADVENTURE", "class_name": "AdventureRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AdventureRoom"] }
  ]
}
